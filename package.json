{
  "name": "decky-bluos-volume",
  "version": "0.1.0",
  "description": "Control BluOS player volume from Steam Deck Quick Access Menu",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fourjuaneight/bluos-volume-decky.git"
  },
  "author": "fourjuaneight",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/fourjuaneight/bluos-volume-decky/issues"
  },
  "homepage": "https://github.com/fourjuaneight/bluos-volume-decky#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@eslint/js": "^10.0.1",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.66.0"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
